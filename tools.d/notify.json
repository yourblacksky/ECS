{
  "name": "notify",
  "version": "1.0.0",
  "description": "在当前 Android/iOS ECS 节点投递一条本地系统通知",
  "platforms": ["android", "ios"],
  "command": "@device",
  "args": ["notify"],
  "timeout": "8s",
  "risk": "medium",
  "input_schema": {
    "type": "object",
    "properties": {
      "title": {
        "type": "string",
        "minLength": 1,
        "maxLength": 80
      },
      "body": {
        "type": "string",
        "minLength": 1,
        "maxLength": 240
      }
    },
    "required": ["title", "body"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "delivered": {"type": "boolean"},
      "id": {}
    },
    "required": ["delivered", "id"]
  }
}

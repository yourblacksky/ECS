{
  "name": "office_action_dispatch",
  "version": "1.0.0",
  "description": "通过可替换的本地任务连接器创建会后行动，并返回结构化幂等回执",
  "capabilities": ["office.task.write"],
  "command": "@builtin",
  "timeout": "8s",
  "risk": "medium",
  "requires_approval": true,
  "input_schema": {
    "type": "object",
    "properties": {
      "action_items": {
        "type": "array",
        "minItems": 1,
        "items": {
          "type": "object",
          "properties": {
            "summary": {"type": "string", "minLength": 1},
            "owner": {"type": "string", "minLength": 1},
            "deadline": {"type": "string"},
            "evidence": {"type": "string"}
          },
          "required": ["summary", "owner"],
          "additionalProperties": false
        }
      },
      "idempotency_key": {"type": "string", "minLength": 1}
    },
    "required": ["action_items", "idempotency_key"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "receipts": {"type": "array", "minItems": 1}
    },
    "required": ["receipts"]
  }
}

{
  "name": "beep",
  "version": "1.0.0",
  "description": "让当前 Android/iOS ECS 节点发出一到三声短蜂鸣",
  "platforms": ["android", "ios"],
  "command": "@device",
  "args": ["beep"],
  "timeout": "5s",
  "risk": "medium",
  "input_schema": {
    "type": "object",
    "properties": {
      "count": {
        "type": "integer",
        "minimum": 1,
        "maximum": 3,
        "description": "蜂鸣次数，只能是 1、2 或 3"
      }
    },
    "required": ["count"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "count": {"type": "integer"},
      "performed": {"type": "boolean"}
    },
    "required": ["count", "performed"]
  }
}

{
  "name": "office_action_compensate",
  "version": "1.0.0",
  "description": "撤销或抵消已执行的办公动作，并返回结构化补偿回执",
  "capabilities": ["office.task.write"],
  "command": "@builtin",
  "timeout": "8s",
  "risk": "high",
  "requires_approval": false,
  "input_schema": {
    "type": "object",
    "properties": {
      "action": {"type": "string", "minLength": 1},
      "work_order": {"type": "string", "minLength": 1},
      "task_id": {"type": "string", "minLength": 1},
      "idempotency_key": {"type": "string", "minLength": 1},
      "receipts": {"type": "array"}
    },
    "required": ["action", "work_order", "task_id", "idempotency_key"],
    "additionalProperties": false
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "receipts": {"type": "array", "minItems": 1}
    },
    "required": ["receipts"]
  }
}

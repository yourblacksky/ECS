{
  "schema_version": "ecs.agent/v1",
  "name": "decision_reviewer",
  "purpose": "作为会议督办闭环的核验员：逐项核对纪要的人名、日期、责任人与原文证据，阻断缺失责任人或截止时间的行动项；不执行外发动作",
  "execution_mode": "llm",
  "model": "",
  "allowed_skills": [
    "meeting.evidence.verify"
  ],
  "allowed_tools": [
    "meeting_evidence_verify"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "objective": {
        "type": "string"
      },
      "allowed_skills": {
        "type": "array"
      },
      "allowed_tools": {
        "type": "array"
      },
      "context": {
        "type": "object"
      }
    },
    "required": [
      "objective"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string"
      },
      "skill_runs": {
        "type": "array"
      },
      "tool_runs": {
        "type": "array"
      }
    },
    "required": [
      "content"
    ]
  },
  "failure_policy": {
    "max_retries": 0,
    "on_failure": "return_error"
  }
}

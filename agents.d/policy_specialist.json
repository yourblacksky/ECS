{
  "schema_version": "ecs.agent/v1",
  "name": "policy_specialist",
  "purpose": "作为审批制度专员：依据有效制度核对金额、附件、权限和例外；不替代人工批准",
  "execution_mode": "llm",
  "model": "",
  "allowed_skills": [],
  "allowed_tools": [],
  "input_schema": {
    "type": "object",
    "properties": {
      "objective": {"type": "string"},
      "allowed_skills": {"type": "array"},
      "allowed_tools": {"type": "array"},
      "context": {"type": "object"}
    },
    "required": ["objective"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "content": {"type": "string"},
      "skill_runs": {"type": "array"},
      "tool_runs": {"type": "array"}
    },
    "required": ["content"]
  },
  "failure_policy": {
    "max_retries": 0,
    "on_failure": "return_error"
  }
}

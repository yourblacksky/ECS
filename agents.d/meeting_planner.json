{
  "schema_version": "ecs.agent/v1",
  "name": "meeting_planner",
  "purpose": "作为会议督办闭环的 planner 角色：识别会议目标、参与人和交付范围，产出会议范围摘要；不执行外发动作",
  "execution_mode": "llm",
  "model": "",
  "allowed_skills": [
    "meeting.scope.plan"
  ],
  "allowed_tools": [
    "meeting_scope_plan"
  ],
  "input_schema": {
    "type": "object",
    "properties": {
      "objective": {
        "type": "string"
      },
      "allowed_skills": {
        "type": "array"
      },
      "allowed_tools": {
        "type": "array"
      },
      "context": {
        "type": "object"
      }
    },
    "required": [
      "objective"
    ]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "content": {
        "type": "string"
      },
      "skill_runs": {
        "type": "array"
      },
      "tool_runs": {
        "type": "array"
      }
    },
    "required": [
      "content"
    ]
  },
  "failure_policy": {
    "max_retries": 0,
    "on_failure": "return_error"
  }
}

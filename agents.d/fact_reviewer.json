{
  "schema_version": "ecs.agent/v1",
  "name": "fact_reviewer",
  "purpose": "作为研究简报的事实核验员：检查来源冲突、材料时效与证据等级，阻断证据不足的结论；不执行发布",
  "execution_mode": "llm",
  "model": "",
  "allowed_skills": [],
  "allowed_tools": [],
  "input_schema": {
    "type": "object",
    "properties": {
      "objective": {"type": "string"},
      "allowed_skills": {"type": "array"},
      "allowed_tools": {"type": "array"},
      "context": {"type": "object"}
    },
    "required": ["objective"]
  },
  "output_schema": {
    "type": "object",
    "properties": {
      "content": {"type": "string"},
      "skill_runs": {"type": "array"},
      "tool_runs": {"type": "array"}
    },
    "required": ["content"]
  },
  "failure_policy": {
    "max_retries": 0,
    "on_failure": "return_error"
  }
}
